<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.ParkGuard.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/pg_radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/pg_outline</item>
        <item name="strokeWidth">@dimen/pg_stroke_width</item>
        <item name="cardBackgroundColor">@color/pg_surface_card</item>
    </style>
    <style name="Widget.ParkGuard.Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/pg_radius_medium</item>
        <item name="android:minHeight">@dimen/pg_touch_target</item>
    </style>
    <style name="Widget.ParkGuard.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/pg_radius_medium</item>
        <item name="boxCornerRadiusTopEnd">@dimen/pg_radius_medium</item>
        <item name="boxCornerRadiusBottomStart">@dimen/pg_radius_medium</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/pg_radius_medium</item>
    </style>
    <style name="TextAppearance.ParkGuard.Plate" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">@dimen/pg_plate_text_size</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Modern Balanced Bottom Navigation Bar (SwiftGo Reference Style - No Clipped Text, Clean Alignment) -->
    <style name="TextAppearance.ParkGuard.BottomNav.Active" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="TextAppearance.ParkGuard.BottomNav.Inactive" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11.5sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Widget.ParkGuard.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@drawable/bg_bottom_nav_modern</item>
        <item name="android:minHeight">64dp</item>
        <item name="elevation">8dp</item>
        <item name="itemIconSize">22dp</item>
        <item name="itemPaddingTop">10dp</item>
        <item name="itemPaddingBottom">10dp</item>
        <item name="itemActiveIndicatorStyle">@null</item>
        <item name="itemIconTint">@color/admin_nav_tint</item>
        <item name="itemTextColor">@color/admin_nav_tint</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.ParkGuard.BottomNav.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.ParkGuard.BottomNav.Inactive</item>
        <item name="itemRippleColor">#14E86A24</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>
</resources>
