<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.parkguardai.ui.auth.LoginFragment"
        android:label="@string/auth_login_title">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment"
            app:enterAnim="@anim/pg_enter"
            app:exitAnim="@anim/pg_exit"
            app:popEnterAnim="@anim/pg_enter"
            app:popExitAnim="@anim/pg_exit" />
        <action
            android:id="@+id/action_login_to_onboarding"
            app:destination="@id/studentOnboardingFragment"
            app:enterAnim="@anim/pg_enter"
            app:exitAnim="@anim/pg_exit" />
        <action
            android:id="@+id/action_login_to_guard"
            app:destination="@id/guardCameraFragment"
            app:enterAnim="@anim/pg_enter"
            app:exitAnim="@anim/pg_exit" />
        <action
            android:id="@+id/action_login_to_student"
            app:destination="@id/studentHomeFragment"
            app:enterAnim="@anim/pg_enter"
            app:exitAnim="@anim/pg_exit" />
        <action
            android:id="@+id/action_login_to_admin"
            app:destination="@id/adminDashboardFragment"
            app:enterAnim="@anim/pg_enter"
            app:exitAnim="@anim/pg_exit" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.parkguardai.ui.auth.RegisterFragment"
        android:label="@string/auth_register_title">
        <action
            android:id="@+id/action_register_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/pg_enter"
            app:exitAnim="@anim/pg_exit" />
        <action
            android:id="@+id/action_register_to_onboarding"
            app:destination="@id/studentOnboardingFragment"
            app:enterAnim="@anim/pg_enter"
            app:exitAnim="@anim/pg_exit" />
    </fragment>

