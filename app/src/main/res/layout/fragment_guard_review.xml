<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_navy_950"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- Nút Quay lại -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="@string/action_back"
            android:textColor="@color/accent_cyan"
            app:icon="@drawable/ic_arrow_back"
            app:iconTint="@color/accent_cyan" />

        <!-- Panel Chỉnh sửa và rà soát -->
        <LinearLayout
            android:id="@+id/editPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Tiêu đề & Phụ đề -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/guard_review_title"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/guard_review_description"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="@color/text_secondary" />

            <!-- Khung ảnh gốc bằng chứng (Card bo góc, nền camera tối) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/surface_900"
                app:cardCornerRadius="18dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:id="@+id/imageFrame"
                    android:layout_width="match_parent"
                    android:layout_height="320dp"
                    android:background="#050B17">

                    <!-- Ảnh gốc chụp hiện trường -->
                    <ImageView
                        android:id="@+id/originalImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/guard_detail_image"
                        android:scaleType="fitCenter" />

                    <!-- Khung chọn cắt biển số kéo thả -->
                    <com.example.parkguardai.ui.guard.CropSelectionView
                        android:id="@+id/cropSelection"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- Badge góc trên ảnh gốc -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="12dp"
                        android:background="@drawable/bg_button_dark_card"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="Ảnh gốc bằng chứng"
                        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                        android:textColor="@color/accent_cyan"
                        android:textStyle="bold" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Nút Cắt vùng biển số (Phong cách Material 3 hiện đại) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cropButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/surface_800"
                android:text="@string/guard_review_crop"
                android:textColor="@color/accent_cyan"
                android:textStyle="bold"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_guard_quick_scan"
                app:iconGravity="textStart"
                app:iconTint="@color/accent_cyan"
                app:strokeColor="@color/accent_cyan"
                app:strokeWidth="1dp" />

            <!-- Khung xem trước vùng biển số đã cắt -->
            <ImageView
                android:id="@+id/cropPreview"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_surface"
                android:contentDescription="@string/guard_review_crop_done"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <!-- Card Thông tin ghi nhận hiện trường & GPS chuẩn DEC-008A -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/surface_800"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- Dòng Thời gian -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_guard_history"
                            app:tint="@color/accent_cyan" />

                        <TextView
                            android:id="@+id/timeText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="@color/text_primary"
                            tools:text="Chụp lúc: 27 thg 10, 2026 15:02" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="8dp"
                        android:background="@color/outline" />

                    <!-- Dòng Vị trí GPS hiện trường -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_guard_map"
                            app:tint="@color/accent_cyan" />

                        <TextView
                            android:id="@+id/locationText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="@color/accent_cyan"
                            tools:text="Vị trí ảnh chính: 10.84124, 106.80982 · sai số 4 m" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_badge_processed"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="DEC-008A"
                            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                            android:textColor="#10B981"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card Thông tin Biển số & Hành vi vi phạm -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/surface_800"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thông tin biển số &amp; Vi phạm"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                        android:textColor="@color/accent_cyan"
                        android:textStyle="bold" />

                    <!-- Ô nhập biển số đã rà soát -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/plateField"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="@string/guard_review_plate"
                        app:boxStrokeColor="@color/accent_cyan"
                        app:errorEnabled="true"
                        app:hintTextColor="@color/accent_cyan">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/plateInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapCharacters"
                            android:letterSpacing="0.08"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Gợi ý từ AI -->
                    <TextView
                        android:id="@+id/plateSuggestionHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_button_dark_card"
                        android:padding="10dp"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="@color/accent_cyan"
                        android:visibility="gone" />

                    <!-- Chọn hành vi vi phạm -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/guard_review_type"
                        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                        android:textColor="@color/text_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/typeSelectButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="6dp"
                        android:backgroundTint="@color/surface_900"
                        android:gravity="center_vertical|start"
                        android:text="@string/guard_review_type_unselected"
                        android:textColor="@color/text_primary"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_alert_triangle"
                        app:iconGravity="textStart"
                        app:iconTint="@color/error_red"
                        app:strokeColor="@color/outline"
                        app:strokeWidth="1dp" />

                    <TextView
                        android:id="@+id/typeErrorText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/guard_review_type_required"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="@color/error_red"
                        android:visibility="gone" />

                    <!-- Mức tiền phạt -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Mức tiền phạt"
                            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/tvPenaltyHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Theo quy định bãi xe"
                            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                            android:textColor="@color/accent_amber" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/penaltyField"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:hint="Số tiền phạt"
                        app:boxStrokeColor="@color/accent_amber"
                        app:hintTextColor="@color/accent_amber">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/penaltyInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:text="100.000 đ"
                            android:textColor="@color/accent_amber"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Hàng chip chọn nhanh mức phạt -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/chipPenalty100"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_button_dark_card"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp"
                                android:text="100.000 đ"
                                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                                android:textColor="@color/text_primary" />

                            <TextView
                                android:id="@+id/chipPenalty150"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_button_dark_card"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp"
                                android:text="150.000 đ"
                                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                                android:textColor="@color/text_primary" />

                            <TextView
                                android:id="@+id/chipPenalty200"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_button_dark_card"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp"
                                android:text="200.000 đ"
                                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                                android:textColor="@color/text_primary" />

                            <TextView
                                android:id="@+id/chipPenalty300"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_button_dark_card"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp"
                                android:text="300.000 đ"
                                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                                android:textColor="@color/text_primary" />

                            <TextView
                                android:id="@+id/chipPenaltyZero"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_button_dark_card"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp"
                                android:text="0 đ (Nhắc nhở)"
                                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                                android:textColor="@color/accent_cyan" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- Khu vực trực áp dụng -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/guard_review_scope"
                        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                        android:textColor="@color/text_primary" />

                    <Spinner
                        android:id="@+id/scopeSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_button_dark_card"
                        android:paddingHorizontal="14dp" />

                    <!-- Ghi chú bổ sung -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/noteField"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/guard_review_note"
                        app:boxStrokeColor="@color/accent_cyan"
                        app:hintTextColor="@color/accent_cyan">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/noteInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences|textMultiLine"
                            android:maxLength="500"
                            android:minLines="2"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Nút Tiếp tục lập biên bản (Full-width, Terracotta Orange) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/continueButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="@color/accent_cyan"
                android:elevation="4dp"
                android:text="@string/guard_review_continue"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:cornerRadius="27dp" />
        </LinearLayout>

        <!-- Panel Xác nhận hồ sơ trước khi gửi (Thiết kế hiện đại, làm nổi bật biển số và chi tiết vi phạm) -->
        <LinearLayout
            android:id="@+id/confirmPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/guard_review_confirm_title"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/guard_review_confirm_text"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/text_secondary" />

            <!-- Card 1: Ảnh bằng chứng xác nhận hiện trường -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/surface_900"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/confirmImage"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:contentDescription="@string/guard_detail_image"
                        android:scaleType="centerCrop" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="10dp"
                        android:background="@drawable/bg_button_dark_card"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="Ảnh hiện trường chính"
                        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                        android:textColor="@color/accent_cyan"
                        android:textStyle="bold" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: NỔI BẬT DANH SÁCH BIỂN SỐ XE VI PHẠM -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/surface_800"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_guard_quick_scan"
                            app:tint="@color/accent_cyan" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="PHƯƠNG TIỆN VI PHẠM"
                            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                            android:textColor="@color/accent_cyan"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvConfirmVehicleCountBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_button_dark_card"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:text="1 xe"
                            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                            android:textColor="@color/accent_cyan"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Container danh sách các thẻ biển số xe -->
                    <LinearLayout
                        android:id="@+id/layoutConfirmPlatesList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical">

                        <!-- Biển số chính nổi bật -->
                        <TextView
                            android:id="@+id/tvConfirmPlateDisplay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_plate_display_box"
                            android:gravity="center"
                            android:letterSpacing="0.08"
                            android:paddingVertical="12dp"
                            android:paddingHorizontal="16dp"
                            android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            tools:text="48-B1 999.99" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: CHI TIẾT HÀNH VI & HIỆN TRƯỜNG -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/surface_800"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_alert_triangle"
                            app:tint="@color/violation_red" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="CHI TIẾT VI PHẠM &amp; HIỆN TRƯỜNG"
                            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                            android:textColor="@color/violation_red"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Lỗi vi phạm dạng badge nổi bật -->
                    <TextView
                        android:id="@+id/tvConfirmViolationType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_badge_violation_pill"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                        android:textColor="@color/violation_red"
                        android:textStyle="bold"
                        tools:text="Chặn lối ra vào (Hàng loạt 3 xe)" />

                    <!-- Dòng Thời gian -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_guard_history"
                            app:tint="@color/text_secondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Thời gian:"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/tvConfirmTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            tools:text="8 thg 11, 2026 16:35" />
                    </LinearLayout>

                    <!-- Dòng Khu vực -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_guard_map"
                            app:tint="@color/text_secondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Khu vực:"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/tvConfirmScope"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="@color/accent_cyan"
                            android:textStyle="bold"
                            tools:text="Bãi xe A (Cổng chính)" />
                    </LinearLayout>

                    <!-- Dòng Tọa độ GPS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_guard_map"
                            app:tint="@color/text_secondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Tọa độ GPS:"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/tvConfirmLocation"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/text_primary"
                            tools:text="10.84124, 106.80982 (sai số 4 m)" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/bg_badge_processed"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:text="DEC-008A"
                            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                            android:textColor="#10B981"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Dòng Ghi chú -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="top"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginTop="2dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_vehicle_document"
                            app:tint="@color/text_secondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Ghi chú:"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/tvConfirmNote"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/text_muted"
                            tools:text="Không có ghi chú bổ sung" />
                    </LinearLayout>

                    <!-- Dòng Mức phạt -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_alert_triangle"
                            app:tint="@color/accent_amber" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Mức phạt:"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/tvConfirmPenalty"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                            android:textColor="@color/accent_amber"
                            android:textStyle="bold"
                            tools:text="100.000 đ" />
                    </LinearLayout>

                    <!-- View tương thích ẩn -->
                    <TextView
                        android:id="@+id/confirmSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/submitStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="@color/accent_cyan" />

            <ProgressBar
                android:id="@+id/submitProgress"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <!-- Nút Gửi hồ sơ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/submitButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/error_red"
                android:elevation="4dp"
                android:text="@string/guard_review_submit"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:cornerRadius="27dp"
                app:icon="@drawable/ic_alert_triangle"
                app:iconGravity="textStart"
                app:iconTint="@color/white" />

            <!-- Nút Quay lại chỉnh sửa -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/backEditButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:text="@string/guard_review_back_edit"
                android:textColor="@color/accent_cyan" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
