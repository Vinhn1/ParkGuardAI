<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_navy_950"
    android:orientation="vertical">

    <!-- Top Bar: Back Button + Tiêu đề Xe quét lại trong ngày -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_round_back_button"
            android:contentDescription="@string/btn_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/guard_rescan_title"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Thẻ Biển số và Thông tin Chủ xe gọn đẹp -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:cardBackgroundColor="@color/surface_900"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvRescanPlate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_plate_display_box"
                            android:letterSpacing="0.06"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="6dp"
                            android:text="--"
                            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            tools:text="68-K4 5584" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvRescanCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_status"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="5dp"
                            android:text="@string/guard_rescan_badge_count"
                            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                            android:textColor="@color/accent_cyan"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_student_vehicle"
                            app:tint="@color/text_muted" />

                        <TextView
                            android:id="@+id/tvRescanOwner"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="Phương tiện • Chưa đăng ký"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Thẻ cảnh báo Amber: Chỉ hiển thị khi có bất thường thật -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRescanAlertBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                app:cardBackgroundColor="#FEF3C7"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#F59E0B"
                app:strokeWidth="1dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_alert_triangle"
                            app:tint="#D97706" />

                        <TextView
                            android:id="@+id/tvRescanAlertTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/guard_rescan_alert_title"
                            android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                            android:textColor="#B45309"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvRescanAlertDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/guard_rescan_alert_desc"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="#92400E" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tiêu đề Các lần quét hôm nay -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:text="@string/guard_rescan_today_scans_title"
                android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <!-- Container nạp động Timeline các lần quét thật -->
            <LinearLayout
                android:id="@+id/layoutRescanTimeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Empty State gọn gàng -->
            <LinearLayout
                android:id="@+id/layoutRescanEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:background="@drawable/bg_card_surface"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:alpha="0.7"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_shield_check"
                    app:tint="@color/text_muted" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/guard_rescan_empty_title"
                    android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/guard_rescan_empty_desc"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <!-- Nút chính: Xe đã ra, bổ sung lượt ra -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSupplementExit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/accent_cyan"
                android:text="@string/guard_rescan_btn_add_exit"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:cornerRadius="24dp" />

            <!-- Hàng 2 nút: Gộp quét trùng + Lập vi phạm (không bị cắt chữ) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMergeScan"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/surface_900"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minHeight="48dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/guard_rescan_btn_merge"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    app:cornerRadius="24dp"
                    app:strokeColor="@color/outline"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSuspiciousPlate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/violation_red"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minHeight="48dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/guard_rescan_btn_suspicious"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="24dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/guardBottomNav"
        style="@style/Widget.ParkGuard.BottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:menu="@menu/guard_bottom_nav" />

</LinearLayout>
