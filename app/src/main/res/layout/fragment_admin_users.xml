<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_navy_950"
    android:orientation="vertical">

    <!-- Top Bar: Back Button + Tiêu đề Quản lý người dùng -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_round_back_button"
            android:contentDescription="@string/btn_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_users_title"
                android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Quản lý nhân sự bảo vệ &amp; Xét duyệt sinh viên"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Thanh Chuyển Tab Cao Cấp (Segmented Control Pill Container) -->
            <LinearLayout
                android:id="@+id/segmentedTabContainer"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_segmented_container"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="3dp">

                <!-- Tab Bảo vệ (Mặc định chọn) -->
                <TextView
                    android:id="@+id/tabGuards"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segmented_active"
                    android:gravity="center"
                    android:text="@string/admin_filter_guard"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <!-- Tab Sinh viên -->
                <TextView
                    android:id="@+id/tabStudents"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.2"
                    android:background="@drawable/bg_segmented_inactive"
                    android:gravity="center"
                    android:text="@string/admin_filter_student"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="@color/text_muted" />

                <!-- Tab Tất cả -->
                <TextView
                    android:id="@+id/tabAllUsers"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.9"
                    android:background="@drawable/bg_segmented_inactive"
                    android:gravity="center"
                    android:text="@string/admin_violations_filter_all"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <!-- 2 Summary Metric Cards (Tổng / Đang trực ca hoặc Chờ duyệt) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Thẻ 1: Tổng số -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSummary1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/surface_800"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/outline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvSummaryLabel1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tổng nhân sự bảo vệ"
                            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                            android:textColor="@color/text_muted" />

                        <TextView
                            android:id="@+id/tvTotalGuards"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0"
                            android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Thẻ 2: Đang trực ca hoặc Chờ duyệt -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSummary2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/surface_800"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/outline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvSummaryLabel2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đang trong ca trực"
                            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                            android:textColor="@color/text_muted" />

                        <TextView
                            android:id="@+id/tvActiveGuards"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0"
                            android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                            android:textColor="#10B981"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Search Box: Tìm theo tên, mã NV, MSSV hoặc SĐT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search"
                    app:tint="@color/text_muted" />

                <EditText
                    android:id="@+id/etSearchUsers"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:background="@null"
                    android:hint="@string/admin_search_users_hint"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Filter Chips nhanh cho Sinh viên (Chỉ hiển thị khi ở tab Sinh viên) -->
            <LinearLayout
                android:id="@+id/containerStudentFilterChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/chipStudentAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_segmented_active"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="Tất cả sinh viên"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipStudentPending"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_reviewing"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="Chờ xét duyệt"
                    android:textColor="#F59E0B"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Danh sách Nhân sự bảo vệ / Sinh viên (Tải động từ Repository) -->
            <LinearLayout
                android:id="@+id/guardListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />

            <!-- Bottom 2 Action Buttons: Phân ca trực + Tạo tài khoản bảo vệ / Duyệt sinh viên -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Nút Phụ (Phân ca trực / Lọc chờ duyệt) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAssignShift"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/surface_800"
                    android:text="@string/admin_btn_assign_shift"
                    android:textColor="@color/text_primary"
                    app:cornerRadius="24dp"
                    app:strokeColor="@color/outline"
                    app:strokeWidth="1dp" />

                <!-- Nút Chính (Tạo tài khoản bảo vệ / Duyệt tất cả) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreateGuard"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1.2"
                    android:backgroundTint="@color/accent_cyan"
                    android:text="@string/admin_btn_create_guard"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:cornerRadius="24dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar 5 Tabs: Cố định 58dp, không đệm thừa -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        style="@style/Widget.ParkGuard.BottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:menu="@menu/admin_bottom_nav" />

</LinearLayout>
