<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pg_bg_canvas"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- Nút Back tối giản -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backButton"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_round_back_button"
                android:contentDescription="@string/action_back"
                app:icon="@drawable/ic_arrow_back"
                app:iconTint="@color/text_primary" />
        </FrameLayout>

        <!-- Brand Hero tối giản -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="18dp"
            android:paddingBottom="8dp">

            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_quick_circle_peach"
                android:padding="20dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/pg_primary_orange" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tiêu đề ngắn gọn giống "Please Login" -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Quên mật khẩu"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Ô nhập Email / Mã số (Bo tròn Pill 26dp, nền trắng, icon thư bên trái) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/emailField"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:boxBackgroundColor="@color/surface_900"
            app:boxCornerRadiusBottomEnd="26dp"
            app:boxCornerRadiusBottomStart="26dp"
            app:boxCornerRadiusTopEnd="26dp"
            app:boxCornerRadiusTopStart="26dp"
            app:boxStrokeColor="@color/outline"
            app:boxStrokeWidth="1dp"
            app:errorEnabled="true"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/ic_mail"
            app:startIconTint="@color/text_muted">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/emailInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:autofillHints="emailAddress"
                android:hint="Email hoặc mã số sinh viên"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="14.5sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 6 ô OTP gọn gàng -->
        <LinearLayout
            android:id="@+id/otpContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/otpDigit1"
                android:layout_width="44dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_otp_digit_box"
                android:gravity="center"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:layout_width="8dp"
                android:layout_height="0dp" />

            <EditText
                android:id="@+id/otpDigit2"
                android:layout_width="44dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_otp_digit_box"
                android:gravity="center"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:layout_width="8dp"
                android:layout_height="0dp" />

            <EditText
                android:id="@+id/otpDigit3"
                android:layout_width="44dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_otp_digit_box"
                android:gravity="center"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:layout_width="8dp"
                android:layout_height="0dp" />

            <EditText
                android:id="@+id/otpDigit4"
                android:layout_width="44dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_otp_digit_box"
                android:gravity="center"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:layout_width="8dp"
                android:layout_height="0dp" />

            <EditText
                android:id="@+id/otpDigit5"
                android:layout_width="44dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_otp_digit_box"
                android:gravity="center"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:layout_width="8dp"
                android:layout_height="0dp" />

            <EditText
                android:id="@+id/otpDigit6"
                android:layout_width="44dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_otp_digit_box"
                android:gravity="center"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Status & Loading -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/loadingProgress"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:contentDescription="@string/auth_forgot_submit"
            android:indeterminateTint="@color/pg_primary_orange"
            android:visibility="gone" />

        <!-- Nút chính: Xác nhận -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/submitButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_button_pill_cyan"
            android:text="@string/auth_action_confirm"
            android:textColor="@color/white"
            android:textSize="15.5sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <!-- Hàng dưới cùng chuẩn mẫu: Trái "Thời gian" — Phải "Gửi lại mã" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/resendTimerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gửi lại mã sau 45 giây"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/resendButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="6dp"
                android:text="@string/auth_action_resend_code"
                android:textColor="@color/pg_primary_orange"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
