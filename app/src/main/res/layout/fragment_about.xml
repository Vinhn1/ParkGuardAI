<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/pg_page_padding">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="@dimen/pg_touch_target"
            android:text="@string/action_back" />
        <ImageView android:layout_width="@dimen/pg_icon_large" android:layout_height="@dimen/pg_icon_large"
            android:layout_marginTop="@dimen/pg_space_large"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_parkguard_mark" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pg_space_large"
            android:text="@string/common_about_title"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
            android:textColor="@color/pg_on_surface" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pg_space_small"
            android:text="@string/common_about_description"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:textColor="@color/pg_on_surface_muted" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pg_space_xlarge"
            android:text="@string/common_about_version"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="@color/pg_on_surface_muted" />
        <TextView android:id="@+id/versionText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/pg_space_small"
            android:text="@string/common_about_version_unknown"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:textColor="@color/pg_on_surface" />
    </LinearLayout>
</ScrollView>
