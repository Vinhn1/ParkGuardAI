<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/pg_page_padding">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="@dimen/pg_touch_target"
            android:text="@string/action_back" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pg_space_large"
            android:text="@string/common_change_password_title"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
            android:textColor="@color/pg_on_surface" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pg_space_small"
            android:text="@string/common_change_password_description"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:textColor="@color/pg_on_surface_muted" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pg_space_xlarge"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical" android:padding="@dimen/pg_space_large">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/student_profile_email"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="@color/pg_on_surface_muted" />
            <TextView android:id="@+id/emailText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/pg_space_small"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/pg_on_surface" />
        </LinearLayout>
        <TextView android:id="@+id/statusText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/pg_space_medium"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/sendButton" style="@style/Widget.ParkGuard.Button.Primary"
            android:layout_width="match_parent" android:layout_height="@dimen/pg_button_height"
            android:layout_marginTop="@dimen/pg_space_large"
            android:text="@string/common_change_password_send" />
    </LinearLayout>
</ScrollView>
