<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="@dimen/pg_page_padding">
        <ImageView
            android:layout_width="@dimen/pg_icon_large"
            android:layout_height="@dimen/pg_icon_large"
            android:contentDescription="@string/auth_access_gate_title"
            android:src="@drawable/ic_parkguard_mark" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pg_space_large"
            android:text="@string/auth_access_gate_title"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
            android:textColor="@color/pg_on_surface" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pg_space_medium"
            android:text="@string/auth_access_gate_description"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:textColor="@color/pg_on_surface_muted" />
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pg_space_large"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/loadingProgress"
            android:layout_width="@dimen/pg_icon_small"
            android:layout_height="@dimen/pg_icon_small"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/pg_space_medium"
            android:contentDescription="@string/auth_access_gate_pending"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/retryButton"
            style="@style/Widget.ParkGuard.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/pg_button_height"
            android:layout_marginTop="@dimen/pg_space_xlarge"
            android:text="@string/auth_access_gate_retry" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/signOutButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/pg_button_height"
            android:layout_marginTop="@dimen/pg_space_small"
            android:text="@string/auth_sign_out" />
    </LinearLayout>
</ScrollView>
