<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_navy_950"
    android:orientation="vertical">

    <!-- Header Bản đồ Khuôn viên -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Bản đồ ĐH Cửu Long"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/guard_map_loading"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/refreshButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_round_back_button"
            android:contentDescription="@string/guard_map_refresh"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_refresh"
            app:tint="@color/accent_cyan" />
    </LinearLayout>

    <!-- Khung Bản đồ MapLibre Khuôn viên ĐH Cửu Long + Banner Cảnh báo Vi phạm nổi -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_weight="1"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/outline"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <org.maplibre.android.maps.MapView
                android:id="@+id/mapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Banner thông báo vi phạm mới ngay trên khu vực bản đồ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLiveViolationBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_margin="10dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                app:cardBackgroundColor="#FFF1F2"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp"
                app:strokeColor="#FCA5A5"
                app:strokeWidth="1dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_alert_triangle"
                        app:tint="@color/violation_red" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvLiveViolationTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                            android:textColor="@color/violation_red"
                            android:textStyle="bold"
                            tools:text="Vi phạm mới: 68-K4 5584" />

                        <TextView
                            android:id="@+id/tvLiveViolationSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                            android:textColor="#7F1D1D"
                            tools:text="Chạm biểu tượng trên bản đồ để xem chi tiết" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/violation_red" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Badge đếm số điểm vi phạm góc dưới trái -->
            <TextView
                android:id="@+id/tvMapViolationCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="10dp"
                android:background="@drawable/bg_selection_card_inactive"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="0 điểm vi phạm"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <!-- Nút chuyển chế độ Bản đồ / Vệ tinh góc dưới phải -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleMapType"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="10dp"
                android:backgroundTint="@color/surface_900"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="12dp"
                android:text="Vệ tinh"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="@color/accent_cyan"
                android:textStyle="bold"
                app:cornerRadius="17dp"
                app:strokeColor="@color/accent_cyan"
                app:strokeWidth="1dp" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Danh sách rút gọn các điểm vi phạm bên dưới bản đồ -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/recordsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Bottom Navigation Bar 5 Tabs -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/guardBottomNav"
        style="@style/Widget.ParkGuard.BottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:menu="@menu/guard_bottom_nav" />

</LinearLayout>
