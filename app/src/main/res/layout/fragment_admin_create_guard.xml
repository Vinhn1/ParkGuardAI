<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_navy_950"
    android:orientation="vertical">

    <!-- Top Bar: Back Button + Tiêu đề Tạo tài khoản bảo vệ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_round_back_button"
            android:contentDescription="@string/btn_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/admin_create_guard_title"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Scrollable Form Content -->
    <ScrollView
        android:id="@+id/scrollViewCreateGuard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:isScrollContainer="true"
        android:paddingHorizontal="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card Ghi chú Phân quyền -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/surface_800"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_kpi_icon_cyan">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_guard_profile"
                            app:tint="@color/accent_cyan" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cấp quyền Nhân viên Bảo vệ"
                            android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                            android:textColor="@color/accent_cyan"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/admin_guard_notice"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/text_muted" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Phần 1: Thông tin nhân viên bảo vệ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/admin_guard_info_section"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="@color/accent_cyan"
                android:textStyle="bold" />

            <!-- Họ và tên -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/admin_guard_name_label"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:textColor="@color/text_primary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_card_surface"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp">

                <EditText
                    android:id="@+id/etGuardName"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="@string/admin_guard_name_hint"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 2 cột: Mã NV + Số điện thoại -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Mã NV -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_guard_code_label"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                        android:textColor="@color/text_primary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_card_surface"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp">

                        <EditText
                            android:id="@+id/etGuardCode"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:hint="@string/admin_guard_code_hint"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="no"
                            android:inputType="textCapCharacters"
                            android:textColor="@color/accent_cyan"
                            android:textColorHint="@color/text_muted"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Số điện thoại -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1.2"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_guard_phone_label"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                        android:textColor="@color/text_primary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_card_surface"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp">

                        <EditText
                            android:id="@+id/etGuardPhone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:hint="@string/admin_guard_phone_hint"
                            android:importantForAutofill="no"
                            android:inputType="phone"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_muted"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Phần 2: Tài khoản & Đăng nhập -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/admin_guard_account_section"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="@color/accent_cyan"
                android:textStyle="bold" />

            <!-- Email cấp cho bảo vệ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/admin_guard_email_label"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:textColor="@color/text_primary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_card_surface"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp">

                <EditText
                    android:id="@+id/etGuardEmail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="@string/admin_guard_email_hint"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Mật khẩu tạm thời (có biểu tượng mắt xem/ẩn mật khẩu) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/admin_guard_password_label"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:textColor="@color/text_primary" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilGuardPassword"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:boxBackgroundColor="@color/surface_900"
                app:boxCornerRadiusBottomEnd="24dp"
                app:boxCornerRadiusBottomStart="24dp"
                app:boxCornerRadiusTopEnd="24dp"
                app:boxCornerRadiusTopStart="24dp"
                app:boxStrokeColor="@color/outline"
                app:boxStrokeWidth="1dp"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/text_muted"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etGuardPassword"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="@string/admin_guard_password_hint"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="0dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Phần 3: Phân công ca trực -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/admin_guard_shift_section"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="@color/accent_cyan"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <!-- Ca sáng (Active) -->
                <TextView
                    android:id="@+id/btnShiftMorning"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segmented_active"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:text="@string/admin_guard_shift_morning"
                    android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <!-- Ca chiều -->
                <TextView
                    android:id="@+id/btnShiftAfternoon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segmented_inactive"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:text="@string/admin_guard_shift_afternoon"
                    android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                    android:textColor="@color/text_muted" />

                <!-- Ca đêm -->
                <TextView
                    android:id="@+id/btnShiftNight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segmented_inactive"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:text="@string/admin_guard_shift_night"
                    android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <!-- Phần 4: Cổng / Khu vực phụ trách -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/admin_guard_scope_section"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="@color/accent_cyan"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <!-- Cổng chính (Active) -->
                <TextView
                    android:id="@+id/chipMainGate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_badge_processed"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:text="@string/admin_scope_main_gate"
                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                    android:textColor="#10B981"
                    android:textStyle="bold" />

                <!-- Cổng phụ -->
                <TextView
                    android:id="@+id/chipSubGate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_surface"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:text="@string/admin_scope_sub_gate"
                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <!-- Bãi xe sinh viên A -->
                <TextView
                    android:id="@+id/chipLotA"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_surface"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:text="@string/admin_scope_lot_a"
                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                    android:textColor="@color/text_muted" />

                <!-- Bãi xe cán bộ B -->
                <TextView
                    android:id="@+id/chipLotB"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_surface"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:text="@string/admin_scope_lot_b"
                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <!-- Nút Tạo tài khoản bảo vệ (Terracotta Orange Button) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitCreateGuard"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:backgroundTint="@color/accent_cyan"
                android:text="@string/admin_btn_submit_guard"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:cornerRadius="26dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
