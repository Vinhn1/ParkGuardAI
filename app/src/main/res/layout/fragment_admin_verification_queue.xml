<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_navy_950"
    android:orientation="vertical">

    <!-- Top Bar: Back Button + Tiêu đề Xe đã đăng ký -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_round_back_button"
            android:contentDescription="@string/btn_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/admin_registered_vehicles_title"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Search Box: Tìm biển số hoặc tên chủ xe (SwiftGo Track Order Style với nút vuông Cam bên phải) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="6dp">

                <EditText
                    android:id="@+id/etSearchVehicle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/admin_search_vehicle_hint"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp" />

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_search_action_orange">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search"
                        app:tint="@color/white" />
                </FrameLayout>
            </LinearLayout>

            <!-- 3 Filter Tabs: Đã duyệt / Chờ duyệt / Bị khoá -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Tab Đã duyệt (Active) -->
                <TextView
                    android:id="@+id/tabApproved"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_segmented_active"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="8dp"
                    android:text="@string/admin_filter_vehicle_approved"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <!-- Tab Chờ duyệt -->
                <TextView
                    android:id="@+id/tabPending"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_segmented_inactive"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="8dp"
                    android:text="@string/admin_filter_vehicle_pending"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="@color/text_muted" />

                <!-- Tab Bị khoá -->
                <TextView
                    android:id="@+id/tabBlocked"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_segmented_inactive"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="8dp"
                    android:text="@string/admin_filter_vehicle_blocked"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <!-- Vehicle Cards List (Tải động từ Repository) -->
            <LinearLayout
                android:id="@+id/vehicleListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />

            <!-- Bottom 2 Action Buttons: Duyệt nhanh + Thêm xe -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Nút Duyệt nhanh -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuickApprove"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/surface_800"
                    android:text="@string/admin_btn_quick_approve"
                    android:textColor="@color/text_primary"
                    app:cornerRadius="24dp"
                    app:strokeColor="@color/outline"
                    app:strokeWidth="1dp" />

                <!-- Nút Thêm xe (Terracotta Orange) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddVehicle"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/accent_cyan"
                    android:text="@string/admin_btn_add_vehicle"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:cornerRadius="24dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar 5 Tabs -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        style="@style/Widget.ParkGuard.BottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:menu="@menu/admin_bottom_nav" />

</LinearLayout>
