<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/pg_space_large">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/guard_type_sheet_title"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
            android:textColor="@color/pg_on_surface" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pg_space_small"
            android:text="@string/guard_type_sheet_description"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/pg_on_surface_muted" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/wrongAreaButton" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="@dimen/pg_button_height"
            android:layout_marginTop="@dimen/pg_space_large"
            android:text="@string/guard_type_wrong_area" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/blockingButton" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="@dimen/pg_button_height"
            android:layout_marginTop="@dimen/pg_space_small"
            android:text="@string/guard_type_blocking" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/noParkingButton" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="@dimen/pg_button_height"
            android:layout_marginTop="@dimen/pg_space_small"
            android:text="@string/guard_type_no_parking" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/otherButton" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="@dimen/pg_button_height"
            android:layout_marginTop="@dimen/pg_space_small"
            android:text="@string/guard_type_other" />
    </LinearLayout>
</ScrollView>
