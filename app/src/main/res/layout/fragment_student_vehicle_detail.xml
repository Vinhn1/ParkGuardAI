<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/pg_page_padding">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="@dimen/pg_touch_target"
            android:text="@string/action_back" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pg_space_large"
            android:text="@string/student_vehicle_detail_title"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
            android:textColor="@color/pg_on_surface" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Thẻ Biển số phong cách Biển số Việt Nam -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pg_space_medium"
                app:cardBackgroundColor="@color/pg_surface_card"
                app:cardCornerRadius="20dp"
                app:strokeColor="@color/pg_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/pg_space_large">

                    <TextView
                        android:id="@+id/tvVehicleStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_status"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="4dp"
                        android:text="--"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                        android:textColor="@color/success_green" />

                    <!-- Khung biển số xe -->
                    <LinearLayout
                        android:layout_width="220dp"
                        android:layout_height="72dp"
                        android:layout_marginTop="@dimen/pg_space_medium"
                        android:background="@drawable/bg_card_surface"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPlateLine1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.08"
                            android:text="--"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textColor="@color/pg_on_surface"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPlateLine2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.08"
                            android:text=""
                            android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                            android:textColor="@color/accent_cyan"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card Thông số xe -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pg_space_large"
                app:cardBackgroundColor="@color/pg_surface_card"
                app:cardCornerRadius="20dp"
                app:strokeColor="@color/pg_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/pg_space_large">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Thông số phương tiện"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/pg_on_surface" />

                    <TextView
                        android:id="@+id/tvVehicleSpecs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/pg_space_medium"
                        android:lineSpacingExtra="4dp"
                        android:text="Đang tải thông tin phương tiện..."
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/pg_on_surface_muted" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card Thẻ gửi xe tháng điện tử -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pg_space_large"
                app:cardBackgroundColor="@color/pg_surface_card"
                app:cardCornerRadius="20dp"
                app:strokeColor="@color/accent_cyan"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/pg_space_large">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Thẻ xe thông minh ParkGuard"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/accent_cyan" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Đã liên kết với camera AI tại cổng ra vào trường. Bảo vệ quét biển số sẽ tự động đối chiếu thẻ hợp lệ."
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="@color/pg_on_surface_muted" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
