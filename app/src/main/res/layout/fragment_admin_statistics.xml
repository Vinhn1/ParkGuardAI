<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pg_surface"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/pg_page_padding">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/pg_touch_target"
                android:text="@string/action_back" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pg_space_small"
                android:text="@string/admin_statistics_title"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                android:textColor="@color/pg_on_surface" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pg_space_xsmall"
                android:text="Số liệu tổng kết hoạt động gửi xe, tỷ lệ xử lý vi phạm và hiệu năng AI."
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="@color/pg_on_surface_muted" />

            <!-- Lưới 4 chỉ số KPI chính -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pg_space_large"
                android:columnCount="2"
                android:rowCount="2">

                <!-- KPI 1 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="@dimen/pg_space_xsmall"
                    android:layout_marginBottom="@dimen/pg_space_small"
                    app:cardBackgroundColor="@color/pg_surface_card"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/pg_outline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/pg_space_medium">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tỷ lệ duyệt xe"
                            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                            android:textColor="@color/pg_on_surface_muted" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="98.2%"
                            android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                            android:textColor="@color/brand_teal" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="1,248 / 1,271 hồ sơ"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/pg_on_surface_muted" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- KPI 2 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="@dimen/pg_space_xsmall"
                    android:layout_marginBottom="@dimen/pg_space_small"
                    app:cardBackgroundColor="@color/pg_surface_card"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/pg_outline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/pg_space_medium">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tiền phạt đã thu"
                            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                            android:textColor="@color/pg_on_surface_muted" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="3.100.000đ"
                            android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                            android:textColor="@color/accent_cyan" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="31 / 42 biên bản"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/pg_on_surface_muted" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- KPI 3 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="@dimen/pg_space_xsmall"
                    app:cardBackgroundColor="@color/pg_surface_card"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/pg_outline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/pg_space_medium">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="AI Box Precision"
                            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                            android:textColor="@color/pg_on_surface_muted" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="97.4%"
                            android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                            android:textColor="@color/accent_amber" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="YOLO TFLite Int8"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/pg_on_surface_muted" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- KPI 4 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="@dimen/pg_space_xsmall"
                    app:cardBackgroundColor="@color/pg_surface_card"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/pg_outline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/pg_space_medium">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="OCR Recognition"
                            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                            android:textColor="@color/pg_on_surface_muted" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="95.8%"
                            android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                            android:textColor="@color/accent_cyan" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Google ML Kit"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/pg_on_surface_muted" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </GridLayout>

            <!-- Card Điểm nóng vi phạm -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pg_space_large"
                android:text="Điểm nóng vi phạm nhiều nhất"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/pg_on_surface" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pg_space_small"
                app:cardBackgroundColor="@color/pg_surface_card"
                app:cardCornerRadius="18dp"
                app:strokeColor="@color/pg_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/pg_space_medium">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1. Sảnh B3 - Nhà xe Cán bộ / Sinh viên"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                        android:textColor="@color/pg_on_surface" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="19 trường hợp • Lỗi chính: Chắn lối đi cứu hỏa &amp; thoát hiểm"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="@color/error_red" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp"
                        android:background="@color/pg_outline" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="2. Lối thoát hiểm hành lang Block A - B"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                        android:textColor="@color/pg_on_surface" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="14 trường hợp • Lỗi chính: Đỗ xe sai khu vực quy định"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="@color/accent_amber" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp"
                        android:background="@color/pg_outline" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="3. Cổng số 2 - Khuôn viên Hội trường lớn"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                        android:textColor="@color/pg_on_surface" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="9 trường hợp • Lỗi chính: Xe lạ không đăng ký tem trường"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="@color/accent_cyan" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card Đánh giá hiệu năng AI Engine -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pg_space_large"
                android:text="Hiệu năng hệ thống &amp; Thiết bị"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/pg_on_surface" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pg_space_small"
                android:layout_marginBottom="@dimen/pg_space_large"
                app:cardBackgroundColor="@color/pg_surface_card"
                app:cardCornerRadius="18dp"
                app:strokeColor="@color/pg_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/pg_space_medium">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp"
                        android:text="• Độ trễ suy luận AI: trung bình 138ms / ảnh\n• Độ chính xác định vị GPS: bán kính sai số &lt; 5m\n• Bộ nhớ RAM chiếm dụng: 82 MB\n• Đồng bộ Offline: Tự động lưu Draft khi mất mạng"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/pg_on_surface" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>

