<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pg_surface"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/pg_page_padding">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/pg_touch_target"
                android:text="@string/action_back" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pg_space_small"
                android:text="@string/admin_violation_types_title"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                android:textColor="@color/pg_on_surface" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pg_space_xsmall"
                android:text="Các loại lỗi và mức chế tài được phép áp dụng bởi Đội Bảo vệ theo nội quy trường."
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="@color/pg_on_surface_muted" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pg_space_large"
                android:orientation="vertical">

                <!-- Loại 1: BLOCKING_ENTRANCE -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/pg_surface_card"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/error_red"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/pg_space_medium">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Chắn lối cứu hỏa &amp; thoát hiểm"
                                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                                android:textColor="@color/pg_on_surface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_status"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:text="NGHIÊM TRỌNG"
                                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                                android:textColor="@color/error_red" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Mã lỗi: BLOCKING_ENTRANCE • Mức chế tài: 100.000 VNĐ\nĐỗ xe chắn trước cầu thang thoát nạn, trụ cứu hỏa hoặc cửa sảnh chính."
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/pg_on_surface_muted" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Loại 2: PARKING_WRONG_AREA -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pg_space_small"
                    app:cardBackgroundColor="@color/pg_surface_card"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/pg_outline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/pg_space_medium">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Đỗ sai khu vực quy định"
                                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                                android:textColor="@color/pg_on_surface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_status"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:text="CẢNH BÁO"
                                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                                android:textColor="@color/accent_amber" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Mã lỗi: PARKING_WRONG_AREA • Mức chế tài: 50.000 VNĐ\nĐỗ xe ngoài vạch sơn kẻ, để xe máy sang khu vực ô tô hoặc nhà xe giảng viên."
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/pg_on_surface_muted" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Loại 3: NO_PARKING_ZONE -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pg_space_small"
                    app:cardBackgroundColor="@color/pg_surface_card"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/pg_outline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/pg_space_medium">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Đỗ xe tại nơi có biển cấm"
                                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                                android:textColor="@color/pg_on_surface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_status"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:text="CẢNH BÁO"
                                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                                android:textColor="@color/accent_amber" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Mã lỗi: NO_PARKING_ZONE • Mức chế tài: 80.000 VNĐ\nDừng đỗ phương tiện ở các cung đường nội bộ có biển báo cấm đỗ."
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/pg_on_surface_muted" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Loại 4: UNREGISTERED_VEHICLE -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pg_space_small"
                    app:cardBackgroundColor="@color/pg_surface_card"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/pg_outline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/pg_space_medium">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Xe chưa đăng ký tem trường"
                                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                                android:textColor="@color/pg_on_surface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_status"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:text="NHẮC NHỞ"
                                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                                android:textColor="@color/accent_cyan" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Mã lỗi: UNREGISTERED_VEHICLE • Mức chế tài: 50.000 VNĐ\nPhương tiện vãng lai hoặc sinh viên chưa đăng ký hồ sơ vào bãi gửi xe tháng."
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/pg_on_surface_muted" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Nút thêm quy định mới -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/addRuleButton"
                style="@style/Widget.ParkGuard.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/pg_button_height"
                android:layout_marginTop="@dimen/pg_space_xlarge"
                android:layout_marginBottom="@dimen/pg_space_large"
                android:text="Thêm loại vi phạm mới" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>

