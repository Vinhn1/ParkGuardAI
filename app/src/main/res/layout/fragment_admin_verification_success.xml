<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
         android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="@dimen/pg_page_padding">
            <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="@dimen/pg_touch_target"
            android:text="@string/action_back" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pg_space_large"
                android:text="@string/admin_verification_success_title"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                android:textColor="@color/pg_on_surface" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pg_space_small"
                android:text="@string/admin_verification_success_description"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="@color/pg_on_surface_muted" />
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pg_space_xlarge"
                app:cardBackgroundColor="@color/pg_surface_card"
                app:cardCornerRadius="20dp"
                app:strokeColor="@color/success_green"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/pg_space_xlarge">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_status"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="4dp"
                        android:text="THÀNH CÔNG"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                        android:textColor="@color/success_green" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/pg_space_medium"
                        android:gravity="center"
                        android:text="Phương tiện đã được cấp phép"
                        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                        android:textColor="@color/pg_on_surface" />

                    <TextView
                        android:id="@+id/tvApprovedSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/pg_space_small"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:text="Hồ sơ xác minh đã được phê duyệt"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/accent_cyan" />

                    <TextView
                        android:id="@+id/tvApprovedDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/pg_space_medium"
                        android:gravity="center"
                        android:text="Sinh viên đã nhận được thông báo xác nhận. Dữ liệu phương tiện đã được đồng bộ realtime lên Cloud Firestore cho hệ thống camera của bảo vệ."
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/pg_on_surface_muted" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/returnQueueButton"
                style="@style/Widget.ParkGuard.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/pg_button_height"
                android:layout_marginTop="@dimen/pg_space_xlarge"
                android:text="Tiếp tục duyệt xe khác" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/returnDashboardButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/pg_button_height"
                android:layout_marginTop="@dimen/pg_space_small"
                android:text="Về Tổng quan Dashboard" />
        </LinearLayout>
    </ScrollView>
    
</LinearLayout>
