<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pg_surface"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/overviewPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/pg_page_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_guard_avatar"
                        android:gravity="center"
                        android:text="@string/guard_home_avatar"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/pg_on_primary_container" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/pg_space_medium"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/guard_home_account_description"
                            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                            android:textColor="@color/pg_on_surface_muted" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/guard_home_greeting"
                            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                            android:textColor="@color/pg_on_surface" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/homeHeroCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pg_space_large"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="3dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_parkguard_hero"
                        android:orientation="vertical"
                        android:padding="@dimen/pg_space_large">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/guard_home_action_eyebrow"
                            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                            android:textColor="@color/pg_hero_accent" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/pg_space_medium"
                            android:text="@string/guard_home_action_title"
                            android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                            android:textColor="@color/white" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/pg_space_small"
                            android:text="@string/guard_home_action_description"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="@color/pg_on_hero" />
                        <TextView
                            android:id="@+id/homeScopeText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/pg_space_medium"
                            android:text="@string/guard_profile_scope_pending"
                            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                            android:textColor="@color/pg_hero_accent" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/captureButton"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/pg_button_height"
                            android:layout_marginTop="@dimen/pg_space_large"
                            android:text="@string/guard_home_open_camera"
                            android:textColor="@color/pg_on_primary_container"
                            app:backgroundTint="@color/pg_secondary"
                            app:cornerRadius="16dp"
                            app:icon="@drawable/ic_guard_quick_scan"
                            app:iconTint="@color/pg_on_primary_container" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pg_space_xlarge"
                    android:text="@string/guard_home_overview_title"
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                    android:textColor="@color/pg_on_surface" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pg_space_medium"
                    android:orientation="horizontal">
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/pg_surface_card"
                        app:cardCornerRadius="20dp"
                        app:strokeColor="@color/pg_outline"
                        app:strokeWidth="1dp">
                        <TextView
                            android:id="@+id/homeDraftCountText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="88dp"
                            android:gravity="center_vertical"
                            android:padding="@dimen/pg_space_medium"
                            android:text="@string/guard_home_draft_count_loading"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textColor="@color/pg_on_surface" />
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/pg_space_small"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/pg_surface_card"
                        app:cardCornerRadius="20dp"
                        app:strokeColor="@color/pg_outline"
                        app:strokeWidth="1dp">
                        <TextView
                            android:id="@+id/homeRecordCountText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="88dp"
                            android:gravity="center_vertical"
                            android:padding="@dimen/pg_space_medium"
                            android:text="@string/guard_home_record_count_loading"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textColor="@color/pg_on_surface" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pg_space_xlarge"
                    android:text="@string/guard_home_shortcuts_title"
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                    android:textColor="@color/pg_on_surface" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pg_space_small"
                    android:orientation="vertical">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/quickScanShortcut"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/pg_button_height"
                        android:text="@string/guard_home_shortcut_scan"
                        app:icon="@drawable/ic_guard_quick_scan"
                        app:iconGravity="textStart" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/recordsShortcut"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/pg_button_height"
                        android:layout_marginTop="@dimen/pg_space_small"
                        android:text="@string/guard_home_shortcut_records"
                        app:icon="@drawable/ic_guard_records"
                        app:iconGravity="textStart" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mapShortcut"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/pg_button_height"
                        android:layout_marginTop="@dimen/pg_space_small"
                        android:text="@string/guard_home_shortcut_map"
                        app:icon="@drawable/ic_guard_map"
                        app:iconGravity="textStart" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pg_space_xlarge"
                    android:text="@string/guard_home_recent_title"
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                    android:textColor="@color/pg_on_surface" />
                <LinearLayout
                    android:id="@+id/homeRecentContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/viewAllRecordsButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/pg_touch_target"
                    android:layout_marginTop="@dimen/pg_space_small"
                    android:text="@string/guard_home_view_all" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/recordsPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/pg_page_padding">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/guard_records_title"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                    android:textColor="@color/pg_on_surface" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pg_space_small"
                    android:text="@string/guard_records_description"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/pg_on_surface_muted" />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pg_space_large"
                    android:hint="@string/guard_records_search_hint">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/recordsSearchInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapCharacters|textNoSuggestions" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/recordsFilterGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pg_space_small"
                    app:singleSelection="true"
                    app:selectionRequired="true">
                    <com.google.android.material.chip.Chip
                        android:id="@+id/recordsFilterAll"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/guard_records_filter_all" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/recordsFilterDrafts"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/guard_records_filter_drafts" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/recordsFilterServer"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/guard_records_filter_server" />
                </com.google.android.material.chip.ChipGroup>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/refreshRecordsButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/pg_button_height"
                    android:layout_marginTop="@dimen/pg_space_large"
                    android:text="@string/guard_retry_access" />
                <TextView
                    android:id="@+id/draftSectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pg_space_xlarge"
                    android:text="@string/guard_draft_title"
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                    android:textColor="@color/pg_on_surface" />
                <LinearLayout
                    android:id="@+id/draftContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
                <TextView
                    android:id="@+id/recordsServerTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pg_space_xlarge"
                    android:text="@string/guard_records_server_title"
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                    android:textColor="@color/pg_on_surface" />
                <TextView
                    android:id="@+id/recordsStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pg_space_small"
                    android:text="@string/guard_profile_scope_pending"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/pg_on_surface_muted" />
                <LinearLayout
                    android:id="@+id/recordsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/profilePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/pg_page_padding">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/guard_nav_profile"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                    android:textColor="@color/pg_on_surface" />
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pg_space_large"
                    app:cardBackgroundColor="@color/pg_surface_card"
                    app:cardCornerRadius="24dp"
                    app:strokeColor="@color/pg_outline"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/pg_space_large">
                        <TextView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_guard_avatar"
                            android:gravity="center"
                            android:text="@string/guard_home_avatar"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textColor="@color/pg_on_primary_container" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/pg_space_medium"
                            android:text="@string/guard_profile_title"
                            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                            android:textColor="@color/pg_on_surface" />
                        <TextView
                            android:id="@+id/profileEmailText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/pg_space_small"
                            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                            android:textColor="@color/pg_on_surface_muted" />
                        <TextView
                            android:id="@+id/profileVerificationText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/pg_space_medium"
                            android:background="@drawable/bg_guard_status"
                            android:paddingHorizontal="@dimen/pg_space_medium"
                            android:paddingVertical="@dimen/pg_space_small"
                            android:text="@string/guard_profile_verified"
                            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                            android:textColor="@color/pg_on_primary_container" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pg_space_xlarge"
                    android:text="@string/guard_profile_account_section"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="@color/pg_on_surface_muted" />
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pg_space_small"
                    app:cardBackgroundColor="@color/pg_surface_card"
                    app:cardCornerRadius="20dp"
                    app:strokeColor="@color/pg_outline"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/pg_space_large">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/guard_profile_scope"
                            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                            android:textColor="@color/pg_on_surface_muted" />
                        <TextView
                            android:id="@+id/profileScopeText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/pg_space_small"
                            android:text="@string/guard_profile_scope_pending"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textColor="@color/pg_on_surface" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/pg_space_small"
                            android:text="@string/guard_profile_scope_description"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/pg_on_surface_muted" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pg_space_xlarge"
                    android:text="@string/guard_profile_actions_section"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="@color/pg_on_surface_muted" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/resetPasswordButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/pg_button_height"
                    android:layout_marginTop="@dimen/pg_space_small"
                    android:text="@string/guard_profile_reset_password" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/signOutButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/pg_button_height"
                    android:layout_marginTop="@dimen/pg_space_small"
                    android:text="@string/auth_sign_out" />
            </LinearLayout>
        </ScrollView>

        <FrameLayout
            android:id="@+id/featureContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        style="@style/Widget.ParkGuard.BottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:menu="@menu/guard_legacy_bottom_nav" />
</LinearLayout>
