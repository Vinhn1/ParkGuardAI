<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/pg_space_large">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/admin_reject_reason_title"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
            android:textColor="@color/pg_on_surface" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pg_space_small"
            android:text="@string/admin_reject_reason_description"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/pg_on_surface_muted" />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/reasonField" style="@style/Widget.ParkGuard.TextField"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pg_space_large"
            android:hint="@string/admin_reject_reason_field">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/reasonInput" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minLines="3"
                android:inputType="textMultiLine" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelButton" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="@dimen/pg_button_height"
            android:layout_marginTop="@dimen/pg_space_large" android:text="@string/action_cancel" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirmButton" style="@style/Widget.ParkGuard.Button.Primary"
            android:layout_width="match_parent" android:layout_height="@dimen/pg_button_height"
            android:layout_marginTop="@dimen/pg_space_small" android:enabled="false"
            android:text="@string/admin_reject_reason_title" />
    </LinearLayout>
</ScrollView>
