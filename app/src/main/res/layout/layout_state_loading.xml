<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_horizontal" android:orientation="vertical"
    android:padding="@dimen/pg_space_large">
    <ProgressBar android:id="@+id/progressBar"
        android:layout_width="@dimen/pg_icon_small" android:layout_height="@dimen/pg_icon_small"
        android:layout_gravity="center_horizontal"
        android:contentDescription="@string/state_loading_title" />
    <TextView android:id="@+id/titleText" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="@dimen/pg_space_medium"
        android:gravity="center" android:text="@string/state_loading_title"
        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
        android:textColor="@color/pg_on_surface" />
    <TextView android:id="@+id/descriptionText" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="@dimen/pg_space_small"
        android:gravity="center" android:text="@string/state_loading_description"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="@color/pg_on_surface_muted" />
    
</LinearLayout>
